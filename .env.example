# Nusxa oling: cp .env.example .env

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Tashkent

# Baza — standart holatda SQLite ishlatiladi.
# PostgreSQL uchun quyidagini oching:
# DB_ENGINE=postgres
# DB_NAME=portfolio
# DB_USER=portfolio
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Cache (ixtiyoriy)
# REDIS_URL=redis://localhost:6379/1

# Contact formasidan email yuborish (bo'sh bo'lsa konsolga chiqadi)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=you@gmail.com
# CONTACT_NOTIFY_EMAIL=you@gmail.com

# Production
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# SECURE_SSL_REDIRECT=True

# AI assistent (Google Gemini). Kalitni aistudio.google.com dan oling.
# GEMINI_API_KEY=
# Ixtiyoriy: modellar zanjiri, vergul bilan (birinchisi ishlamasa keyingisi)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Telegram webhook uchun tasodifiy sir (32+ belgi). Bot tokeni TELEGRAM_BOT_TOKEN da.
# TELEGRAM_WEBHOOK_SECRET=
# Ega sifatida tan olinadigan Telegram id (bo'sh bo'lsa TELEGRAM_CHAT_ID olinadi)
# AI_OWNER_TELEGRAM_ID=
# Ega bilan muloqot tili: uz | ru | en
# AI_OWNER_LANG=uz
# Mehmon limitlari: soatiga, kuniga va barcha mehmonlar uchun kuniga
# AI_GUEST_HOURLY=20
# AI_GUEST_DAILY=60
# AI_DAILY_LIMIT=400
